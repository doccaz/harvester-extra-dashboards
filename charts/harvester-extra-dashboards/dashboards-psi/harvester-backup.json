          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Per VM",
      "collapsed": false,
      "id": 15,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Backup status per VM",
      "description": "Newest/oldest = age in days of the last backup of the VM's backed-up volumes. 'Never' counts volumes with no backup at all. Snapshot columns show the space and the number of user-created snapshots on the VM's volumes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "id": 16,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, name) (label_replace(label_replace((longhorn_volume_last_backup_at * 0 + 1), \"namespace\", \"$1\", \"pvc_namespace\", \"(.*)\"), \"persistentvolumeclaim\", \"$1\", \"pvc\", \"(.*)\") * on (namespace, persistentvolumeclaim) group_left (name) (max by (namespace, persistentvolumeclaim, name) (kubevirt_vm_disk_allocated_size_bytes{namespace=~\"$namespace\"}) * 0 + 1))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
